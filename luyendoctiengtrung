                      <div className="grid grid-cols-3 gap-2 text-center text-xs">
                        <div className="p-2 bg-white dark:bg-slate-900 rounded-xl">
                          <p className="text-[10px] text-slate-400">Chính xác</p>
                          <p className="font-black text-teal-600">{evaluationResult.accuracy}%</p>
                        </div>
                        <div className="p-2 bg-white dark:bg-slate-900 rounded-xl">
                          <p className="text-[10px] text-slate-400">Thanh điệu</p>
                          <p className="font-black text-amber-600">{evaluationResult.tone}%</p>
                        </div>
                        <div className="p-2 bg-white dark:bg-slate-900 rounded-xl">
                          <p className="text-[10px] text-slate-400">Lưu loát</p>
                          <p className="font-black text-blue-600">{evaluationResult.fluency}%</p>
                        </div>
                      </div>

                      <p className="text-xs text-slate-700 dark:text-slate-300 leading-relaxed bg-white/60 dark:bg-slate-900/60 p-2.5 rounded-xl">
                        💡 {evaluationResult.feedback}
                      </p>

                      <button
                        onClick={() => {
                          const nextIdx = (activeSentenceIndex + 1) % currentArticle.sentences.length;
                          setActiveSentenceIndex(nextIdx);
                          setEvaluationResult(null);
                        }}
                        className="w-full py-2.5 bg-teal-700 hover:bg-teal-800 text-white font-bold text-xs rounded-xl shadow-xs"
                      >
                        Luyện câu tiếp theo →
                      </button>
                    </div>
                  )}

                </div>
              </div>

            </div>

          </main>

          {/* MODAL CHI TIẾT TỪ VỰNG KHI CHẠM VÀO CHỮ */}
          {inspectedWord && (
            <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 rounded-3xl p-6 max-w-sm w-full border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 animate-in zoom-in-95">
                <div className="flex items-center justify-between">
                  <span className="px-2 py-0.5 rounded-md text-xs font-bold bg-teal-100 text-teal-800">
                    {inspectedWord.level || 'HSK'}
                  </span>
                  <button onClick={() => setInspectedWord(null)} className="text-slate-400 hover:text-slate-600 text-sm font-bold">
                    ✕
                  </button>
                </div>

                <div className="text-center space-y-1">
                  <p className="text-4xl font-black hanzi-text">{inspectedWord.word}</p>
                  <p className="text-sm font-mono text-red-600 font-bold">[{inspectedWord.pinyin}]</p>
                  <p className="text-xs text-amber-700 dark:text-amber-400 font-bold">Hán Việt: {inspectedWord.hanViet}</p>
                  <p className="text-sm font-semibold text-slate-800 dark:text-slate-200 mt-2">{inspectedWord.meaning}</p>
                </div>

                <button
                  onClick={() => speakChinese(inspectedWord.word)}
                  className="w-full py-2.5 bg-teal-700 text-white rounded-xl text-xs font-bold"
                >
                  🔊 Nghe Phát Âm Từ Này
                </button>
              </div>
            </div>
          )}

          {/* MODAL TỰ TẠO BÀI ĐỌC MỚI */}
          {showCreateModal && (
            <div className="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 max-w-lg w-full border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4 animate-in zoom-in-95">
                <div>
                  <h3 className="text-lg font-bold">➕ Tự Tạo Bài Đọc Hằng Ngày</h3>
                  <p className="text-xs text-slate-500">Dán hoặc nhập đoạn văn tiếng Trung để hệ thống tự động bôi màu và chấm điểm Shadowing.</p>
                </div>

                <form onSubmit={handleCreateArticle} className="space-y-3 text-xs">
                  <div>
                    <label className="font-bold block mb-1">Tiêu Đề Bài Đọc *</label>
                    <input
                      type="text"
                      required
                      placeholder="Ví dụ: Đàm phán xuất khẩu trà xanh"
                      value={newTitle}
                      onChange={(e) => setNewTitle(e.target.value)}
                      className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold"
                    />
                  </div>

                  <div>
                    <label className="font-bold block mb-1">Cấp Độ HSK Mục Tiêu</label>
                    <select
                      value={newLevel}
                      onChange={(e) => setNewLevel(e.target.value)}
                      className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-bold"
                    >
                      {Object.keys(HSK_COLORS).map(lvl => (
                        <option key={lvl} value={lvl}>{lvl}</option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="font-bold block mb-1">Nội Dung Tiếng Trung (Tách theo dấu chấm câu) *</label>
                    <textarea
                      rows="4"
                      required
                      placeholder="Dán đoạn văn tiếng Trung vào đây (Ví dụ: 我们很高兴能够与贵司展开合作。希望未来一切顺利。)..."
                      value={newChineseText}
                      onChange={(e) => setNewChineseText(e.target.value)}
                      className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 font-medium"
                    ></textarea>
                  </div>

                  <div>
                    <label className="font-bold block mb-1">Bản Dịch Tiếng Việt (Tùy chọn)</label>
                    <textarea
                      rows="2"
                      placeholder="Dịch nghĩa tham khảo..."
                      value={newVietText}
                      onChange={(e) => setNewVietText(e.target.value)}
                      className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800"
                    ></textarea>
                  </div>

                  <div className="flex gap-2 pt-2">
                    <button
                      type="button"
                      onClick={() => setShowCreateModal(false)}
                      className="flex-1 py-3 bg-slate-100 dark:bg-slate-800 rounded-xl font-bold"
                    >
                      Hủy bỏ
                    </button>
                    <button
                      type="submit"
                      className="flex-1 py-3 bg-teal-700 text-white rounded-xl font-bold shadow-md hover:bg-teal-800"
                    >
                      🚀 Bắt Đầu Học Ngay
                    </button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* FOOTER */}
          <footer className="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-4 text-center text-xs text-slate-500 mt-auto">
            Tam Thanh Chinese &copy; 2026 - Luyện Đọc, Shadowing & Bôi Màu HSK 1 Đến HSK 9
          </footer>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
