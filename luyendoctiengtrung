                    className={`px-4 py-2.5 rounded-xl text-xs font-bold flex items-center gap-2 transition-all ${
                      isPlayingFull ? 'bg-rose-600 text-white animate-pulse' : 'bg-teal-700 hover:bg-teal-800 text-white shadow-md'
                    }`}
                  >
                    <span>{isPlayingFull ? '⏸️ Dừng phát' : '🔊 Nghe Toàn Bài'}</span>
                  </button>

                  <button
                    onClick={() => setShowPinyin(!showPinyin)}
                    className={`px-3 py-2 rounded-xl text-xs font-bold border transition-all ${
                      showPinyin ? 'bg-red-50 text-red-700 border-red-200' : 'bg-slate-100 text-slate-600 border-slate-200'
                    }`}
                  >
                    Pinyin: {showPinyin ? 'BẬT' : 'TẮT'}
                  </button>

                  <button
                    onClick={() => setShowVietnamese(!showVietnamese)}
                    className={`px-3 py-2 rounded-xl text-xs font-bold border transition-all ${
                      showVietnamese ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200'
                    }`}
                  >
                    Dịch: {showVietnamese ? 'BẬT' : 'TẮT'}
                  </button>

                  <button
                    onClick={() => setEnableColorHighlight(!enableColorHighlight)}
                    className={`px-3 py-2 rounded-xl text-xs font-bold border transition-all ${
                      enableColorHighlight ? 'bg-amber-50 text-amber-900 border-amber-300' : 'bg-slate-100 text-slate-600 border-slate-200'
                    }`}
                  >
                    🎨 Bôi màu HSK: {enableColorHighlight ? 'BẬT' : 'TẮT'}
                  </button>
                </div>
              </div>

              {/* CHÚ GIẢI BẢNG MÀU TỪ VỰNG HSK 1 ĐẾN 9 */}
              {enableColorHighlight && (
                <div className="p-3.5 bg-slate-50 dark:bg-slate-800/60 rounded-2xl border border-slate-200 dark:border-slate-700 space-y-2">
                  <div className="flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-300">
                    <span>🎨 Chú giải cấp độ bôi màu HSK 1 - 9 (Bấm vào để lọc riêng):</span>
                    {filterHighlightLevel !== 'ALL' && (
                      <button onClick={() => setFilterHighlightLevel('ALL')} className="text-teal-700 font-bold hover:underline">
                        Hiện lại tất cả màu
                      </button>
                    )}
                  </div>
                  <div className="flex flex-wrap items-center gap-1.5">
                    {Object.entries(HSK_COLORS).map(([lvl, cfg]) => (
                      <button
                        key={lvl}
                        onClick={() => setFilterHighlightLevel(filterHighlightLevel === lvl ? 'ALL' : lvl)}
                        className={`px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 border transition-all ${cfg.bg} ${cfg.text} ${cfg.border} ${
                          filterHighlightLevel === lvl ? 'ring-2 ring-slate-900 dark:ring-white scale-105' : 'opacity-90'
                        }`}
                      >
                        <span className="w-2.5 h-2.5 rounded-full inline-block" style={{ backgroundColor: cfg.hex }} />
                        <span>{lvl}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* Danh sách chọn bài đọc */}
              <div className="flex items-center gap-2 overflow-x-auto pb-1 custom-scrollbar">
                {filteredArticles.map((art) => (
                  <button
                    key={art.id}
                    onClick={() => {
                      setSelectedArticleId(art.id);
                      setActiveSentenceIndex(0);
                      setEvaluationResult(null);
                    }}
                    className={`px-3.5 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-2 ${
                      selectedArticleId === art.id
                        ? 'bg-teal-700 text-white shadow-xs'
                        : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200'
                    }`}
                  >
                    <span>{art.title}</span>
                    <span className="text-[10px] px-1.5 py-0.5 rounded bg-white/20">{art.level}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* PHÒNG LUYỆN ĐỌC & STUDIO SHADOWING 3 BƯỚC */}
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              
              {/* CỘT TRÁI: BÀI ĐỌC TƯƠNG TÁC (7 CỘT) */}
              <div className="lg:col-span-7 bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
                <div className="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                  <h3 className="font-bold text-base flex items-center gap-2">
                    <span>📖 Nội Dung Bài Đọc & Bôi Màu HSK</span>
                  </h3>
                  <span className="text-xs text-slate-400">Bấm từng câu để luyện Shadowing</span>
                </div>

                <div className="space-y-4">
                  {currentArticle.sentences.map((sent, index) => {
                    const isActive = activeSentenceIndex === index;
                    const score = shadowingHistory[sent.chinese];

                    return (
                      <div
                        key={index}
                        onClick={() => {
                          setActiveSentenceIndex(index);
                          setEvaluationResult(null);
                        }}
                        className={`p-4 rounded-2xl border transition-all cursor-pointer ${
                          isActive
                            ? 'border-teal-600 bg-teal-50/70 dark:bg-teal-950/40 shadow-xs ring-2 ring-teal-200 dark:ring-teal-800'
                            : 'border-slate-200 dark:border-slate-800 hover:border-teal-300 bg-white dark:bg-slate-900'
                        }`}
                      >
                        <div className="flex items-center justify-between mb-2">
                          <div className="flex items-center gap-2">
                            <span className={`w-6 h-6 rounded-full text-xs font-bold flex items-center justify-center ${
                              isActive ? 'bg-teal-700 text-white' : 'bg-slate-200 dark:bg-slate-700'
                            }`}>
                              {index + 1}
                            </span>
                            {score && (
                              <span className="px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                                Đã chấm: {score}đ
                              </span>
                            )}
                          </div>
                          <button
                            onClick={(e) => {
                              e.stopPropagation();
                              speakChinese(sent.chinese, speechRate);
                            }}
                            className="px-2.5 py-1 bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300 hover:bg-teal-100 rounded-lg text-xs font-bold"
                          >
                            🔊 Nghe câu
                          </button>
                        </div>

                        {/* Đoạn tiếng Trung bôi màu theo HSK 1-9 */}
                        <div className="text-lg sm:text-xl font-medium leading-loose">
                          {renderColoredSentence(sent.chinese)}
                        </div>

                        {/* Pinyin */}
                        {showPinyin && sent.pinyin && (
