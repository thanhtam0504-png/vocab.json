                    <span className="text-xs text-slate-400">•</span>
                    <span className="text-xs text-slate-500 font-medium">{currentArticle.category}</span>
                    {currentArticle.level === userLevel && (
                      <span className="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300">
                        ★ Phù hợp trình độ của bạn
                      </span>
                    )}
                  </div>
                  <h2 className="text-xl sm:text-2xl font-black">{currentArticle.title}</h2>
                  <p className="text-xs text-slate-500 mt-1">{currentArticle.summary}</p>
                </div>

                {/* Các công tắc bật tắt Pinyin & Bôi màu HSK */}
